OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Public browser configuration. The anon key is safe only together with RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Server-only keys must never use the VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
CRON_SECRET=your_random_cron_bearer_secret

# Server-only transactional Company Watch email configuration.
# Keep disabled outside Vercel Production; the sender domain must be verified by Resend.
WATCH_EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_your_server_only_resend_api_key
WATCH_EMAIL_FROM=Watch Assistant <notifications@your-verified-domain.example>
WATCH_APP_BASE_URL=https://your-production-domain.example
